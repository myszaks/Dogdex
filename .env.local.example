# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Site URL (używane w linkach e-mail: reset hasła, OAuth) ───────────────────
# Ustaw na docelową domenę produkcyjną, aby linki w mailach zawsze prowadziły
# na właściwy adres, nawet gdy mail wysłano z podglądu na Vercelu.
NEXT_PUBLIC_SITE_URL=https://dogdex.pro

# ── Email (Nodemailer / Gmail SMTP) ───────────────────────────────────────────
# Generate Gmail App Password at: myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=twoj@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM=Dogdex <twoj@gmail.com>
# Opcjonalnie: skrzynka odbierająca formularz kontaktowy
CONTACT_EMAIL=kontakt@dogdex.pro

# ── Access Gate (optional staging/preview allowlist) ──────────────────────────
# Set ALLOWLIST_ENABLED=1 to restrict access to ALLOWED_EMAILS only.
# Leave unset or set to 0 to disable (production default).
ALLOWLIST_ENABLED=0
ALLOWED_EMAILS=alice@example.com,bob@example.com

# ── Cron job secret (chroni wszystkie endpointy zadań cyklicznych) ──────────
# Wygeneruj: openssl rand -hex 32
# Ustaw tę wartość w Vercel Dashboard → Settings → Environment Variables.
# Dla Supabase Cron zapisz tę samą wartość w Vault jako "dogdex_cron_secret".
# Adres danego wdrożenia zapisz w Vault jako "dogdex_site_url", np.
# https://develop.dogdex.pro dla developmentu lub https://dogdex.pro dla produkcji.
CRON_SECRET=replace-with-a-long-random-secret

# Opcjonalne: connected account w trybie testowym używany przez seed treningów.
# Bez tej wartości seed tworzy wyłącznie darmową ofertę QA.
DOGDEX_QA_STRIPE_ACCOUNT_ID=acct_test
